# === Secrets — never commit these ===
# (Yagami stores secrets in Postgres now, not env files. These patterns
#  remain to catch anything legacy or experimental.)
.env
*.session

# === Python ===
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/
dist/

# === Node / frontend ===
node_modules/
services/frontend/dist/

# === Go ===
services/api-gateway/api-gateway
.cache/

# === Elixir ===
services/youtube-poller/_build/
services/youtube-poller/deps/
services/youtube-poller/*.ez

# === Rust ===
services/downloader/target/

# === IDE ===
.idea/
.vscode/
*.swp
*.swo

# === OS ===
.DS_Store
Thumbs.db
